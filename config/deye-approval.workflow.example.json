{
  "name": "Deye private recommendation approval",
  "on": {
    "repository_dispatch": {"types": ["deye-recommendation"]},
    "issue_comment": {"types": ["created"]}
  },
  "permissions": {},
  "concurrency": {
    "group": "deye-private-approval",
    "cancel-in-progress": false
  },
  "jobs": {
    "approval": {
      "if": "${{ github.event.repository.private && github.event.repository.name == 'DeyeCloud-data' && github.ref == 'refs/heads/main' && vars.DEYE_APPROVAL_ENABLED == 'true' && (github.event_name == 'repository_dispatch' || (!github.event.issue.pull_request && startsWith(github.event.comment.body, '/deye ') && contains(fromJSON(vars.DEYE_APPROVER_IDS || '[]'), github.event.comment.user.id))) }}",
      "runs-on": "ubuntu-24.04",
      "timeout-minutes": 15,
      "permissions": {"contents": "write", "issues": "write"},
      "steps": [
        {
          "name": "Checkout public approval code",
          "uses": "actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd",
          "with": {
            "repository": "mrg321/DeyeCloud",
            "ref": "refs/heads/main",
            "persist-credentials": false
          }
        },
        {
          "name": "Set up Python",
          "uses": "actions/setup-python@83679a892e2d95755f2dac6acb0bfd1e9ac5d548",
          "with": {"python-version": "3.12"}
        },
        {
          "name": "Validate and record approval event",
          "run": "python -m pip install --disable-pip-version-check -r requirements-actions.txt && python -B scripts/approve_deye.py",
          "env": {
            "GH_TOKEN": "${{ github.token }}",
            "DEYE_APPROVAL_CODE_REPOSITORY": "mrg321/DeyeCloud",
            "DEYE_APPROVER_IDS": "${{ vars.DEYE_APPROVER_IDS }}",
            "DEYE_APPROVER_LOGINS": "${{ vars.DEYE_APPROVER_LOGINS }}",
            "DEYE_APPROVAL_CUTOFF": "${{ vars.DEYE_APPROVAL_CUTOFF }}",
            "DEYE_TOU_WRITE_ENABLED": "${{ vars.DEYE_TOU_WRITE_ENABLED }}"
          }
        },
        {
          "name": "Apply and verify approved TOU",
          "if": "${{ github.event_name == 'issue_comment' && vars.DEYE_TOU_WRITE_ENABLED == 'true' }}",
          "run": "python -B scripts/approve_deye.py",
          "env": {
            "GH_TOKEN": "${{ github.token }}",
            "DEYE_APPROVAL_CODE_REPOSITORY": "mrg321/DeyeCloud",
            "DEYE_APPROVER_IDS": "${{ vars.DEYE_APPROVER_IDS }}",
            "DEYE_APPROVER_LOGINS": "${{ vars.DEYE_APPROVER_LOGINS }}",
            "DEYE_APPROVAL_STAGE": "execute",
            "DEYE_TOU_WRITE_ENABLED": "${{ vars.DEYE_TOU_WRITE_ENABLED }}",
            "DEYE_AUTH_MODE": "environment",
            "DEYE_APP_ID": "${{ secrets.DEYE_APP_ID }}",
            "DEYE_APP_SECRET": "${{ secrets.DEYE_APP_SECRET }}",
            "DEYE_EMAIL": "${{ secrets.DEYE_EMAIL }}",
            "DEYE_PASSWORD": "${{ secrets.DEYE_PASSWORD }}"
          }
        }
      ]
    }
  }
}
