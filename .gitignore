# Public repository roots are opt-in. Keep local state and unexpected outputs out.
/*
!/.gitignore
!/README.md
!/requirements.txt
!/scripts/
!/tests/
!/docs/
!/config/

/scripts/*
!/scripts/*.py
/tests/*
!/tests/test_*.py
/docs/*
!/docs/deye_local.md
!/docs/PUBLICATION.md
/config/*
!/config/deye_local.example.toml

**/__pycache__/
*.py[cod]
**/.env
**/.env.*
**/*.pem
**/*.key
**/credentials.json
**/secrets.*
**/Configuracion.md
**/Consumos.log
