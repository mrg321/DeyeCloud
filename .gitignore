# Public repository roots are opt-in. Keep local state and unexpected outputs out.
/*
!/.gitignore
!/README.md
!/requirements.txt
!/requirements-actions.txt
!/.github/
!/scripts/
!/tests/
!/docs/
!/config/

/scripts/*
!/scripts/*.py
/tests/*
!/tests/test_*.py
/docs/*
!/docs/deye_local.md
!/docs/PUBLICATION.md
!/docs/automation.md
/config/*
!/config/deye_local.example.toml
!/config/data.example.json

/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/deye-daily.yml

**/__pycache__/
*.py[cod]
**/.env
**/.env.*
**/*.pem
**/*.key
**/credentials.json
**/secrets.*
**/Configuracion.md
**/Consumos.log
